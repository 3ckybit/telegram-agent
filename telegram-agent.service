[Unit]
Description=Alex's Universal Telegram Agent
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/telegram-agent
ExecStart=/home/pi/telegram-agent/venv/bin/python3 bot.py
Restart=always
RestartSec=10
EnvironmentFile=/home/pi/telegram-agent/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
